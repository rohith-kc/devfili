# DevFili environment variables. Copy to .env.local and fill in. NEVER commit .env.local.
# Server-only unless the name starts with NEXT_PUBLIC_.

# --- Google AI Studio (Gemini) ---
GEMINI_API_KEY=
# Only for the OpenAI-compatible fallback path:
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Defaults work on the free tier. For a stronger model, set any ID listed by: npm run check-keys
GEMINI_MODEL_RESEARCH=gemini-flash-latest
GEMINI_MODEL_CHECK=gemini-flash-latest

# --- Groq ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_DRAFT=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
# groq/compound was decommissioned 2026-09-21. Unused placeholder; the research
# fallback uses the browser_search tool on GROQ_MODEL_DRAFT instead. See docs/DECISIONS.md.
GROQ_MODEL_COMPOUND=groq/compound

# --- Your own model endpoint: ANY OpenAI-compatible API (the plug-and-play option) ---
# Fill ONLY these three and leave GEMINI_API_KEY / GROQ_API_KEY blank, and DevFili runs every stage on this endpoint.
#   LLM_BASE_URL  the API's "chat completions" base URL, e.g.
#                 OpenAI        https://api.openai.com/v1
#                 xAI (Grok)    https://api.x.ai/v1
#                 AWS Bedrock   https://bedrock-runtime.<region>.amazonaws.com/openai/v1   (use a Bedrock API key)
#                 OpenRouter    https://openrouter.ai/api/v1   (one key for Claude, GPT, Gemini and more)
#                 a company gateway or any other OpenAI-compatible URL
#   LLM_API_KEY   the key or bearer token that endpoint expects
#   LLM_MODEL     the model id that endpoint serves
# Web search: only OpenRouter has it built in. On every other endpoint DevFili fetches the provider's public
# developer pages itself and gives them to the model to read, so no search feature is needed.
# If Gemini/Groq keys are also set, this endpoint is a last fallback, unless PRIMARY_PROVIDER=custom.
# (The older OPENROUTER_API_KEY / OPENROUTER_BASE_URL / OPENROUTER_MODEL names still work.)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional: custom = try this endpoint before Gemini and Groq. Blank = automatic.
PRIMARY_PROVIDER=
# Optional: auto (default: built-in search only on openrouter.ai) | off | on
LLM_WEB_SEARCH=

# --- Which provider does research and checking (gemini or groq) ---
PROVIDER_RESEARCH=gemini
PROVIDER_CHECK=gemini

# --- Supabase (database and GitHub sign-in) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# DevFili's own daily caps. Off by default when you run it locally (npm run dev). Set RATE_LIMITS=off
# to remove them anywhere, or on to force them. (Provider limits such as Gemini/Groq quotas are separate.)
RATE_LIMITS=
LIVE_RUNS_PER_GUEST_PER_DAY=5
LIVE_RUNS_PER_USER_PER_DAY=15
LIVE_RUNS_GLOBAL_PER_DAY=150
HELPER_RUNS_PER_DAY=30
RESEARCH_CACHE_DAYS=7
RESEARCH_DEADLINE_SECONDS=240
# Any long random string
IP_HASH_SALT=
