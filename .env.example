# DevFili environment variables. Copy to .env.local and fill in. NEVER commit .env.local.
# Server-only unless the name starts with NEXT_PUBLIC_.

# --- Google AI Studio (Gemini) ---
GEMINI_API_KEY=
# Only for the OpenAI-compatible fallback path:
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Defaults work on the free tier. For a stronger model, set any ID listed by: npm run check-keys
GEMINI_MODEL_RESEARCH=gemini-flash-latest
GEMINI_MODEL_CHECK=gemini-flash-latest

# --- Groq ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_DRAFT=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
# groq/compound was decommissioned 2026-09-21. Unused placeholder; the research
# fallback uses the browser_search tool on GROQ_MODEL_DRAFT instead. See docs/DECISIONS.md.
GROQ_MODEL_COMPOUND=groq/compound

# --- OpenRouter (optional third fallback tier, after Gemini and Groq) ---
# Leave blank to disable - every call site checks for this key before using it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Choose a real model ID your OpenRouter account can use, e.g. from
# https://openrouter.ai/models - confirm it with: npm run check-keys
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Which provider does research and checking (gemini or groq) ---
PROVIDER_RESEARCH=gemini
PROVIDER_CHECK=gemini

# --- Supabase (database and GitHub sign-in) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LIVE_RUNS_PER_GUEST_PER_DAY=5
LIVE_RUNS_PER_USER_PER_DAY=15
LIVE_RUNS_GLOBAL_PER_DAY=150
HELPER_RUNS_PER_DAY=30
RESEARCH_CACHE_DAYS=7
RESEARCH_DEADLINE_SECONDS=240
# Any long random string
IP_HASH_SALT=
